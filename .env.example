NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
SHORT_URL_BASE=http://localhost:3001

DATABASE_URL=postgresql://shortener:shortener@localhost:5433/shortener?schema=public

REDIS_URL=redis://localhost:6380

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

CACHE_TTL_SECONDS=300

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CREATE_LINK_IP_LIMIT=20

BULL_PREFIX=shortener
